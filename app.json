{
  "expo": {
    "scheme": "loammobile",
    "name": "Loam",
    "slug": "loam-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ing.loam.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "ing.loam.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Loam needs access to your photo library so you can add a photo to your post."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Loam checks which of your contacts are already on Loam so you can connect with them. Contacts are scrambled on your device before being checked."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Loam needs access to your camera so you can take photos for your posts.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#462B01"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bfaf41e4-8994-4728-8c3d-37a10f215970"
      }
    }
  }
}
